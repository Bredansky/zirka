{
  "name": "zirka",
  "version": "0.0.42",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bredansky/zirka"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/styleguide.js",
      "require": "./dist/styleguide.cjs"
    },
    "./typescript": "./typescript/base.json"
  },
  "types": "dist/styleguide.d.ts",
  "files": [
    "dist",
    "typescript",
    "types"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck",
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "lint-staged": {
    "!(*.ts|*.mts|*.cts|*.tsx|*.js|*.cjs|*.mjs|*.jsx)": "prettier --write --ignore-unknown",
    "*.ts|*.mts|*.cts|*.tsx|*.js|*.cjs|*.mjs|*.jsx": "npx eslint --fix"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.0",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@next/eslint-plugin-next": "^15.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/node": "^22.15.29",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^16.2.0",
    "jiti": "^2.6.1",
    "pasika": "^0.3.2",
    "prettier-plugin-packagejson": "^2.5.14",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript-eslint": "^8.68.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "eslint": "^10.9.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
